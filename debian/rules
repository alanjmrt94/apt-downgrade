#!/usr/bin/make -f

export DH_VERBOSE = 1
export DEB_BUILD_MAINT_OPTIONS = hardening=+all
export DEB_CFLAGS_MAINT_APPEND = -Wall -Wextra

%:
	dh $@

override_dh_auto_clean:
	$(MAKE) clean-build

override_dh_auto_build:
	# Hereda CFLAGS de dpkg-buildflags (incluye -g para el .ddeb)
	$(MAKE) build

override_dh_auto_install:
	$(MAKE) install DESTDIR=$(CURDIR)/debian/apt-downgrade PREFIX=/usr

override_dh_auto_test:
	@# tests/ no va en el tarball PPA; CI/git sí lo tienen.
	@if [ -x tests/run_tests.sh ]; then \
		$(MAKE) test; \
	else \
		echo "Skipping tests (not present in source package)"; \
	fi
